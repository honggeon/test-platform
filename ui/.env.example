# ── 后端 / LangGraph 地址（与仓库根目录 .env 保持一致即可）──
# next.config.mjs 会读取：仓库根 .env → backend/.env → 本目录 .env.local
# 优先使用 PUBLIC_API_URL（与后端、HAT 脚本共用），无需在 UI 重复写端口。
#
# 示例（也可写在项目根 .env）：
# PUBLIC_API_URL=http://localhost:8000
# BACKEND_PORT=8000
# LANGGRAPH_API_URL=http://localhost:2026

# 后端 API 地址（next.config 会从 PUBLIC_API_URL 注入 NEXT_PUBLIC_API_URL）
NEXT_PUBLIC_API_URL=http://localhost:8000

# LangGraph：开发环境走 Next 代理 /lg，只需端口（与 start_server.py 一致）
NEXT_PUBLIC_LANGGRAPH_API_URL=/lg
NEXT_PUBLIC_LANGGRAPH_API_PORT=2026

# 测试用例生成智能体的 ID
NEXT_PUBLIC_TESTCASE_GENERATOR_ASSISTANT_ID=testcase_generator_agent

# 一般不必设置 NEXT_PUBLIC_API_URL（由 next.config 从 PUBLIC_API_URL 注入）
# NEXT_PUBLIC_API_URL=http://localhost:8000

